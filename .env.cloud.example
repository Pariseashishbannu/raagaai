# Cloud Training Environment Variables

# ============================================================================
# AWS SageMaker Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/SageMakerRole
AWS_S3_BUCKET=raaga-ai-bucket
AWS_TRAINING_INSTANCE=ml.g4dn.xlarge

# ============================================================================
# GCP Vertex AI Configuration
# ============================================================================
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
GCP_GCS_BUCKET=raaga-ai-bucket
GCP_TRAINING_MACHINE=n1-standard-4
GCP_GPU_TYPE=NVIDIA_TESLA_T4
GCP_NUM_GPUS=1
# For service account: export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================================================
# Azure Machine Learning Configuration
# ============================================================================
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=raaga-ai-rg
AZURE_WORKSPACE_NAME=raaga-ai-workspace
AZURE_TRAINING_COMPUTE=gpu-cluster
AZURE_TRAINING_INSTANCE=Standard_NC6

# ============================================================================
# Training Configuration
# ============================================================================
TRAINING_EPOCHS=50
TRAINING_BATCH_SIZE=32
TRAINING_LEARNING_RATE=0.0003
TRAINING_NUM_GPUS=1

# ============================================================================
# Monitoring & Logging
# ============================================================================
TENSORBOARD_ENABLED=true
LOG_LEVEL=INFO
