FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e .

COPY . .

CMD ["celery", "-A", "src.workers.celery_app", "worker", "--loglevel=info", "--queues=generation,synthesis", "--concurrency=2"]
